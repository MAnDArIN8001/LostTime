  "title": "LostTime core mechanic plan for push/pull/press",
  "objective": "Сделать отдельную ветку реализации core-механики push/pull/press на базе IMarkable, IPressable и IControlable, а затем уже строить поверх нее character integration, world objects, quest и HUD.",
  "execution_contract": {
    "one_leaf_task_one_sub_agent": true,
    "root_tasks_are_orchestrators": true,
    "orchestrator_tasks_assignable": false,
    "leaf_tasks_only": true,
    "task_must_be_atomic": true,
    "take_task_only_when_dependencies_completed": true,
    "subtasks_allowed": true,
    "wide_scope_policy": [
      "Широкая задача оформляется как orchestration-task.",
      "В работу уходит только leaf-task.",
      "Core-ветка LT-CORE является обязательной и приоритетной относительно vertical slice задач."
    ],
    "parallelism_policy": [
      "Параллелить только leaf-task без пересечения write_scope.",
      "При конфликте write_scope исполнять задачи последовательно.",
      "Приоритет у correctness и архитектурной чистоты core-механики."
    ]
  },
  "architecture_guardrails": {
    "product_shape": "modular monolith with isolated core interaction branch",
    "patterns": [
      "interface-driven design",
      "event-driven",
      "observer",
      "separated character feature"
    ],
    "rules": [
      "Core interaction vocabulary не должен зависеть от quest, HUD и scene wiring.",
      "Маркировка целей идет через IMarkable.",
      "Коммуникация идет через IPressable и IControlable.",
      "Character interaction feature должна жить отдельно от текущей movement/combat state machine либо использовать отдельную локальную state machine.",
      "Push и pull должны быть pointer-driven.",
      "Quest и HUD подключаются к core через bridges и adapters."
    ],
    "anti_goals": [
      "Без переписывания текущего Character и HFSM с нуля.",
      "Без зашивания логики взаимодействий в quest progression.",
      "Без hardcoded puzzle objects как единственного варианта расширения.",
      "Без привязки core-механики к одной конкретной сцене."
    ],
    "module_layout": [
      "Scripts/Gameplay/Interaction/Core",
      "Scripts/Gameplay/Interaction/Character",
      "Scripts/Gameplay/Interaction/World",
      "Scripts/Gameplay/Interaction/Authoring",
      "Scripts/Quest",
      "Scripts/UI"
    ]
  },

  m_Name: MentorDialogueDefinition
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue.Authoring.DialogueDefinition
  <DialogueId>k__BackingField: mentor_intro
  <DisplayName>k__BackingField: Mentor Intro
  <StartNodeId>k__BackingField: n1
  _nodes:
  - <NodeId>k__BackingField: n1
    <SpeakerId>k__BackingField: mentor
    <SpeakerName>k__BackingField: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    <Text>k__BackingField: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E
      \u0442\u0435\u0431\u044F, \u0443\u0447\u0435\u043D\u0438\u043A. \u042F \u2014
      \u0442\u0432\u043E\u0439 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A
      \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435. \u041F\u043E\u0437\u0432\u043E\u043B\u044C
      \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0442\u0435\u0431\u044F \u0447\u0435\u0440\u0435\u0437
      \u043E\u0441\u043D\u043E\u0432\u044B \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C."
    <NodeType>k__BackingField: 0
    _entryConditions: []
    _options:
    - <OptionId>k__BackingField: continue_1
      <Text>k__BackingField: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      <NextNodeId>k__BackingField: n2
      _conditions: []
  - <NodeId>k__BackingField: n2
    <SpeakerId>k__BackingField: mentor
    <SpeakerName>k__BackingField: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    <Text>k__BackingField: "\u041F\u0435\u0440\u0432\u043E\u0435, \u0447\u0442\u043E
      \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C
      \u2014 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438 \u0432\u043E\u043A\u0440\u0443\u0433.
      \u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u043B\u044E\u0431\u043E\u043C\u0443
      \u043E\u0431\u044A\u0435\u043A\u0442\u0443 \u0438 \u043F\u043E\u0442\u044F\u043D\u0438
      \u0435\u0433\u043E \u043D\u0430 \u0441\u0435\u0431\u044F \u0438\u043B\u0438
      \u0442\u043E\u043B\u043A\u043D\u0438 \u043E\u0442 \u0441\u0435\u0431\u044F.
      \u041C\u043D\u043E\u0433\u0438\u0435 \u0437\u0430\u0433\u0430\u0434\u043A\u0438
      \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u0438\u043C\u0435\u043D\u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u043C."
    <NodeType>k__BackingField: 0
    _entryConditions: []
    _options:
    - <OptionId>k__BackingField: continue_2
      <Text>k__BackingField: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      <NextNodeId>k__BackingField: n3
      _conditions: []
  - <NodeId>k__BackingField: n3
    <SpeakerId>k__BackingField: mentor
    <SpeakerName>k__BackingField: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    <Text>k__BackingField: "\u0414\u0430\u043B\u0435\u0435 \u2014 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435.
      \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F \u043F\u043E
      \u043C\u0438\u0440\u0443. \u041D\u0435 \u0431\u043E\u0439\u0441\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u2014 \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0433\u043E\u043B\u043E\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0432\u0430\u0436\u043D\u043E\u0435."
    <NodeType>k__BackingField: 0
    _entryConditions: []
    _options:
    - <OptionId>k__BackingField: continue_3
      <Text>k__BackingField: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      <NextNodeId>k__BackingField: n4
      _conditions: []
  - <NodeId>k__BackingField: n4
    <SpeakerId>k__BackingField: mentor
    <SpeakerName>k__BackingField: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    <Text>k__BackingField: "\u0418 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u2014
      \u043C\u0430\u0433\u0438\u044F. \u0422\u044B \u043D\u0430\u0434\u0435\u043B\u0451\u043D
      \u0434\u0430\u0440\u043E\u043C \u043A\u0430\u0441\u0442\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F. \u042D\u0442\u043E
      \u0442\u0432\u043E\u0451 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0441\u0438\u043B\u0443 \u043C\u0443\u0434\u0440\u043E \u2014 \u043E\u043D\u0430
      \u043C\u043E\u0436\u0435\u0442 \u043A\u0430\u043A \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u043F\u0443\u0442\u044C, \u0442\u0430\u043A \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0435\u0433\u043E."
    <NodeType>k__BackingField: 0
    _entryConditions: []
    _options:
    - <OptionId>k__BackingField: continue_4
      <Text>k__BackingField: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
      <NextNodeId>k__BackingField: n5
      _conditions: []
  - <NodeId>k__BackingField: n5
    <SpeakerId>k__BackingField: mentor
    <SpeakerName>k__BackingField: "\u041D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A"
    <Text>k__BackingField: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C
      \u0432\u0441\u0451 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0435.
      \u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0441\u0435\u0431\u044F. \u0418\u0441\u043F\u044B\u0442\u0430\u0439 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0438\u0437 \u0441\u0432\u043E\u0438\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
      \u2014 \u0442\u044F\u043D\u0438, \u0442\u043E\u043B\u043A\u0430\u0439, \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0439\u0441\u044F
      \u0438 \u043A\u0430\u0441\u0442\u0443\u0439. \u0414\u043E\u043A\u0430\u0436\u0438,
      \u0447\u0442\u043E \u0442\u044B \u0433\u043E\u0442\u043E\u0432 \u043A \u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0436\u0434\u0451\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    <NodeType>k__BackingField: 1
    _entryConditions: []
    _options:
    - <OptionId>k__BackingField: opt_ready
      <Text>k__BackingField: "\u042F \u0433\u043E\u0442\u043E\u0432. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
      <NextNodeId>k__BackingField: 
      _conditions: []
